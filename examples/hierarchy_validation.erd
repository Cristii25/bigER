erdiagram HierarchyValidation

// ==================================================
// Ejemplos de jerarquías válidas
// ==================================================


// ==================================================
// Caso 1:
// Una misma entidad base puede tener varias
// jerarquías independientes.
// Ejemplo basado en el caso indicado por Álvaro.
// ==================================================

entity Employee {
    id: INT key
    name: VARCHAR(100)
}

// Jerarquía por puesto
hierarchy h_job Employee partial disjoint

entity Administrative extends h_job {
    id: INT key
    category: VARCHAR(100)
}

entity Technician extends h_job {
    id: INT key
    level: VARCHAR(100)
}

entity Engineer extends h_job {
    id: INT key
    engineer_type: VARCHAR(100)
}


// Jerarquía de gerencia.
// Al tener una única subclase, solo puede ser partial.
hierarchy h_management Employee partial

entity Manager extends h_management {
    id: INT key
}


// Jerarquía por jornada
hierarchy h_schedule Employee total disjoint

entity PartTimeEmployee extends h_schedule {
    id: INT key
    weekly_hours: INT
}

entity FullTimeEmployee extends h_schedule {
    id: INT key
    salary: INT
}


// ==================================================
// Caso 2:
// Jerarquía total + overlapping
// ==================================================

entity Vehicle {
    id: INT key
}

hierarchy h_vehicle Vehicle total overlapping

entity Car extends h_vehicle {
    id: INT key
}

entity AmphibiousVehicle extends h_vehicle {
    id: INT key
}


// ==================================================
// Caso 3:
// Jerarquía partial + overlapping
// ==================================================

entity Worker {
    id: INT key
}

hierarchy h_worker Worker partial overlapping

entity Developer extends h_worker {
    id: INT key
}

entity TeamLeader extends h_worker {
    id: INT key
}


// ==================================================
// Caso 4:
// Jerarquías multinivel
// Una entidad puede ser subclase de una jerarquía
// y, a su vez, base de otra.
// ==================================================

entity Person {
    id: INT key
}

hierarchy h_person Person partial

entity Student extends h_person {
    id: INT key
}

hierarchy h_student Student total disjoint

entity UndergraduateStudent extends h_student {
    id: INT key
}

entity PostgraduateStudent extends h_student {
    id: INT key
}


// ==================================================
// Ejemplos de jerarquías no válidas
//
// Descomentar cada caso por separado para probar
// las validaciones.
// ==================================================


// ==================================================
// Caso no válido 1:
// Una jerarquía debe tener al menos una subclase.
// ==================================================
//
// entity Product {
//     id: INT key
// }
//
// hierarchy h_product Product partial


// ==================================================
// Caso no válido 2:
// Una jerarquía con una única subclase solo puede
// declararse como partial.
// ==================================================
//
// entity SingleBase {
//     id: INT key
// }
//
// hierarchy h_single SingleBase total
//
// entity SingleChild extends h_single {
//     id: INT key
// }


// ==================================================
// Caso no válido 3:
// Una jerarquía con una única subclase no puede
// indicar disjoint ni overlapping.
// ==================================================
//
// entity SingleConstraintBase {
//     id: INT key
// }
//
// hierarchy h_single_constraint SingleConstraintBase partial disjoint
//
// entity SingleConstraintChild extends h_single_constraint {
//     id: INT key
// }


// ==================================================
// Caso no válido 4:
// Una jerarquía con dos o más subclases debe indicar
// disjoint u overlapping.
// ==================================================
//
// entity MultipleBase {
//     id: INT key
// }
//
// hierarchy h_multiple MultipleBase partial
//
// entity MultipleChild1 extends h_multiple {
//     id: INT key
// }
//
// entity MultipleChild2 extends h_multiple {
//     id: INT key
// }


// ==================================================
// Caso no válido 5:
// La subclase debe declarar la misma clave que
// su superclase.
// ==================================================
//
// entity KeyBase {
//     id: INT key
// }
//
// hierarchy h_key KeyBase partial
//
// entity InvalidKeyChild extends h_key {
//     another_id: INT key
// }


// ==================================================
// Caso no válido 6:
// Una entidad débil no puede ser la base de una
// jerarquía.
// ==================================================
//
// weak entity WeakBase {
//     id: INT partial-key
// }
//
// hierarchy h_weak WeakBase partial
//
// entity WeakChild extends h_weak {
//     id: INT key
// }


// ==================================================
// Caso no válido 7:
// No se permiten ciclos de herencia.
// ==================================================
//
// entity EntityA extends h_b {
//     id: INT key
// }
//
// entity EntityB extends h_a {
//     id: INT key
// }
//
// hierarchy h_a EntityA partial
// hierarchy h_b EntityB partial